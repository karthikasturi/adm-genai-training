# Copy this file to .env in the same folder and fill in the key(s) you have.
# .env is git-ignored at the repo root - never commit real keys.
#
# You only need ONE of these to run the examples, but every script supports
# both providers - set both to compare them side by side.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

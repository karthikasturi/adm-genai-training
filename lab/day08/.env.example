# Copy this file to .env in the same folder and fill in your key(s).
# .env is git-ignored at the repo root - never commit real keys.
#
# OPENAI_API_KEY is REQUIRED for every exercise - the RAG tool reused from
# Day 16 (answer_guest_question) always calls OpenAI's embeddings endpoint,
# even if your chat model below is Anthropic's.
# ANTHROPIC_API_KEY is optional - only used if you point CHAT_MODEL at
# Anthropic in any exercise.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

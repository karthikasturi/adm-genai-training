# Copy this file to .env in the same folder and fill in your key(s).
# .env is git-ignored at the repo root - never commit real keys.
#
# OPENAI_API_KEY is REQUIRED for every exercise - embeddings always call
# OpenAI in this exercise set (Anthropic doesn't offer its own embedding
# model; see the README's "A note on embeddings and vendor choice").
# ANTHROPIC_API_KEY is optional - only used if you point CHAT_MODEL at
# Anthropic in exercises 05 and 06.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

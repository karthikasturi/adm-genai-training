# Copy this file to .env in the same folder and fill in the key(s) you have.
# .env is git-ignored at the repo root - never commit real keys.
#
# You only need ONE of these - init_chat_model picks the right one based
# on the provider prefix in the MODEL string ("anthropic:..." or
# "openai:...") in each exercise file.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
